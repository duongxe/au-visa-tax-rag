# Copy thành .env rồi điền giá trị. KHÔNG commit file .env.

# --- LLM: thử lần lượt theo chuỗi, nhà cung cấp nào không có key thì bỏ qua ---
# Lỗi (quá tải, hết lượt, hết credit, sai key, timeout) -> tự chuyển sang bước tiếp theo.
# Để trống = dùng chuỗi mặc định trong src/generation/llm.py. Định dạng: provider:model,provider:model
# LLM_CHAIN=gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,openai:gpt-5-mini
# LLM_FAST_CHAIN=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-20b

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys (có gói miễn phí)
GROQ_API_KEY=
# https://console.mistral.ai/api-keys (gói Experiment miễn phí, cần xác minh số điện thoại)
MISTRAL_API_KEY=
# https://openrouter.ai/keys (dùng model ":free": ~20 lượt/phút, 50 lượt/ngày; 1000 lượt/ngày nếu nạp $10)
OPENROUTER_API_KEY=
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# vector | hybrid | hybrid_rerank (mặc định)
RETRIEVAL_MODE=hybrid_rerank
INDEX_DIR=data/index
# 0 = không dùng reranker (máy nhỏ / bản cloud); hybrid_rerank tự chuyển thành hybrid
# RERANK_ENABLED=1

# Giới hạn cho bản public (0 = không giới hạn)
# MAX_ASKS_PER_DAY=0
# MAX_ASKS_PER_MINUTE=0
# Mỗi lần gọi LLM tối đa LLM_TIMEOUT_S giây; cả chuỗi dự phòng dừng sau LLM_DEADLINE_S giây (0 = không giới hạn)
# LLM_TIMEOUT_S=45
# LLM_DEADLINE_S=0

API_URL=http://localhost:8000
